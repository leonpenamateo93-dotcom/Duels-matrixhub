
-- MATRIXHUB MOBILE
-- LocalScript en StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local flying = false
local fast = false
local locked = false
local flySpeed = 55
local normalSpeed = 16
local fastSpeed = 55
local up, down = false, false
local move = Vector2.zero
local flyConnection
local velocity, gyro

local gui = Instance.new("ScreenGui")
gui.Name = "MatrixHubMobile"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.Size = UDim2.fromOffset(230, 245)
panel.Position = UDim2.new(0, 15, 0.25, 0)
panel.BackgroundColor3 = Color3.fromRGB(5, 15, 10)
panel.BorderColor3 = Color3.fromRGB(0, 255, 90)
panel.BorderSizePixel = 2
panel.Active = true
panel.Draggable = true
panel.Parent = gui

local function button(parent, text, pos, size)
    local b = Instance.new("TextButton")
    b.Size = size
    b.Position = pos
    b.BackgroundColor3 = Color3.fromRGB(0, 40, 18)
    b.BorderColor3 = Color3.fromRGB(0, 255, 90)
    b.TextColor3 = Color3.fromRGB(0, 255, 90)
    b.TextScaled = true
    b.Font = Enum.Font.Code
    b.Text = text
    b.Parent = parent
    return b
end

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 35)
title.BackgroundColor3 = Color3.fromRGB(0, 60, 25)
title.Text = "MATRIXHUB MOBILE"
title.TextColor3 = Color3.fromRGB(0, 255, 90)
title.TextScaled = true
title.Font = Enum.Font.Code
title.Parent = panel

local flyBtn = button(panel, "FLY: OFF",
    UDim2.fromOffset(10, 45), UDim2.new(1, -20, 0, 38))

local runBtn = button(panel, "FAST RUN: OFF",
    UDim2.fromOffset(10, 90), UDim2.new(1, -20, 0, 38))

local lockBtn = button(panel, "SCREEN LOCK: OFF",
    UDim2.fromOffset(10, 135), UDim2.new(1, -20, 0, 38))

local hideBtn = button(panel, "HIDE PANEL",
    UDim2.fromOffset(10, 180), UDim2.new(1, -20, 0, 38))

local reopen = button(gui, "M", UDim2.new(0, 15, 0.5, 0),
    UDim2.fromOffset(48, 48))
reopen.Visible = false

local controls = Instance.new("Frame")
controls.Size = UDim2.fromOffset(150, 150)
controls.Position = UDim2.new(1, -165, 1, -190)
controls.BackgroundTransparency = 1
controls.Parent = gui

local upBtn = button(controls, "UP",
    UDim2.fromOffset(50, 0), UDim2.fromOffset(50, 45))
local downBtn = button(controls, "DOWN",
    UDim2.fromOffset(50, 100), UDim2.fromOffset(50, 45))

local function bindHold(btn, callback)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            callback(true)
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            callback(false)
        end
    end)
end

bindHold(upBtn, function(v) up = v end)
bindHold(downBtn, function(v) down = v end)

local function getChar()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if hum and root then return char, hum, root end
end

local function stopFly()
    flying = false
    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
    if velocity then velocity:Destroy() velocity = nil end
    if gyro then gyro:Destroy() gyro = nil end
    flyBtn.Text = "FLY: OFF"
    controls.Visible = false
end

local function startFly()
    local char, hum, root = getChar()
    if not root then return end

    flying = true
    flyBtn.Text = "FLY: ON"
    controls.Visible = true

    velocity = Instance.new("BodyVelocity")
    velocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    velocity.Velocity = Vector3.zero
    velocity.Parent = root

    gyro = Instance.new("BodyGyro")
    gyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    gyro.P = 9000
    gyro.Parent = root

    flyConnection = RunService.RenderStepped:Connect(function()
        local _, _, currentRoot = getChar()
        if not flying or not currentRoot then
            stopFly()
            return
        end

        local camera = workspace.CurrentCamera
        local direction = hum.MoveDirection

        if up then direction += Vector3.yAxis end
        if down then direction -= Vector3.yAxis end

        velocity.Velocity = direction.Magnitude > 0
            and direction.Unit * flySpeed or Vector3.zero
        gyro.CFrame = camera.CFrame
    end)
end

flyBtn.Activated:Connect(function()
    if flying then stopFly() else startFly() end
end)

runBtn.Activated:Connect(function()
    local _, hum = getChar()
    if not hum then return end
    fast = not fast
    hum.WalkSpeed = fast and fastSpeed or normalSpeed
    runBtn.Text = fast and "FAST RUN: ON" or "FAST RUN: OFF"
end)

-- Bloquea la cámara en su posición actual.
-- Pulsa de nuevo para desbloquearla.
local savedCameraType, savedCameraSubject, savedCFrame

lockBtn.Activated:Connect(function()
    local camera = workspace.CurrentCamera
    locked = not locked

    if locked then
        savedCameraType = camera.CameraType
        savedCameraSubject = camera.CameraSubject
        savedCFrame = camera.CFrame
        camera.CameraType = Enum.CameraType.Scriptable
        camera.CFrame = savedCFrame
        lockBtn.Text = "SCREEN LOCK: ON"
    else
        camera.CameraType = savedCameraType or Enum.CameraType.Custom
        camera.CameraSubject = savedCameraSubject
        lockBtn.Text = "SCREEN LOCK: OFF"
    end
end)

hideBtn.Activated:Connect(function()
    panel.Visible = false
    reopen.Visible = true
end)

reopen.Activated:Connect(function()
    panel.Visible = true
    reopen.Visible = false
end)

player.CharacterAdded:Connect(function()
    stopFly()
    fast = false
    task.wait(0.5)
    local _, hum = getChar()
    if hum then hum.WalkSpeed = normalSpeed end
    runBtn.Text = "FAST RUN: OFF"
end)
