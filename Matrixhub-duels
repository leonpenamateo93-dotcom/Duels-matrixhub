local function RenderTab(tabName)
    CurrentTab = tabName
    ClearContent()

    if tabName == "Home" then
        Section("Panel principal")

        AddLabel(
            "Matrix Hub | Duels",
            "Interfaz móvil para una experiencia propia de Roblox."
        )

        AddLabel(
            "Estado",
            "Las preferencias visuales se conservan durante esta sesión."
        )

        AddButton("Mostrar información", function()
            Notify("Matrix Hub está funcionando.")
        end)

        AddButton("Restablecer preferencias", function()
            Config.ESP = false
            Config.Tracers = false
            Config.AimAssist = false
            Config.FOV = 120
            Config.MovementSpeed = 16

            Config.Preferences = {}

            Notify("Preferencias restablecidas.")
            RenderTab(CurrentTab)
        end)

    elseif tabName == "Player ESP" then
        Section("Indicadores visuales")

        AddLabel(
            "Player ESP",
            "Configura indicadores para tu propia experiencia."
        )

        AddToggle("Activar indicadores", "ESP", function(enabled)
            Notify(enabled
                and "ESP solicitado."
                or "ESP desactivado.")
        end)

        AddLabel(
            "Integración",
            "Los indicadores deben conectarse a un módulo visual autorizado."
        )

    elseif tabName == "Tracers" then
        Section("Líneas visuales")

        AddToggle("Activar trazadores", "Tracers", function(enabled)
            Notify(enabled
                and "Trazadores solicitados."
                or "Trazadores desactivados.")
        end)

        AddLabel(
            "Rendimiento",
            "Limita los objetos visuales y actualiza solo cuando sea necesario."
        )

    elseif tabName == "Aim Assist" then
        Section("Pruebas de apuntado")

        AddToggle("Activar sistema de pruebas", "AimAssist", function(enabled)
            Notify(enabled
                and "Sistema de pruebas habilitado."
                or "Sistema de pruebas desactivado.")
        end)

        AddSlider("Campo de visión", "FOV", 30, 300, function(value)
            -- Este valor solo configura la interfaz.
            -- No realiza selección ni seguimiento de objetivos.
        end)

        AddLabel(
            "Modo autorizado",
            "La asistencia real requiere integrarse con la lógica de tu experiencia privada."
        )

    elseif tabName == "Movement" then
        Section("Movimiento de pruebas")

        AddSlider(
            "Velocidad solicitada",
            "MovementSpeed",
            8,
            32,
            function(value)
                -- No modifica directamente el personaje.
                -- El servidor de tu experiencia debe validar el cambio.
            end
        )

        AddButton("Restablecer velocidad", function()
            Config.MovementSpeed = 16
            Config.Preferences.MovementSpeed = 16

            Notify("Velocidad solicitada restablecida a 16.")
            RenderTab("Movement")
        end)

        AddLabel(
            "Seguridad",
            "Aplica cambios de movimiento mediante un sistema validado por el servidor."
        )

    elseif tabName == "Settings" then
        Section("Configuración")

        AddLabel(
            "Preferencias de sesión",
            "Los valores permanecen mientras esta interfaz siga activa."
        )

        AddButton("Cerrar interfaz", function()
            ScreenGui:Destroy()
        end)

        AddLabel(
            "Optimización móvil",
            "Evita bucles por fotograma cuando no sean necesarios."
        )
    end
end

--==================================================
-- CREAR PESTAÑAS
--==================================================

for index, tabName in ipairs(Tabs) do
    local button = Create("TextButton", {
        Name = tabName,
        Size = UDim2.fromOffset(
            tabName == "Player ESP" and 92
            or tabName == "Aim Assist" and 90
            or 76,
            32
        ),
        BackgroundColor3 = Config.Secondary,
        Text = tabName,
        TextColor3 = Config.Muted,
        TextSize = 10,
        Font = Enum.Font.GothamSemibold,
        AutoButtonColor = false,
        LayoutOrder = index,
    }, TabBar)

    Round(button, 7)

    TabButtons[tabName] = button

    button.Activated:Connect(function()
        for name, tabButton in pairs(TabButtons) do
            local selected = name == tabName

            Animate(tabButton, {
                BackgroundColor3 = selected
                    and Config.Accent
                    or Config.Secondary,

                TextColor3 = selected
                    and Config.Background
                    or Config.Muted,
            }, 0.15)
        end

        RenderTab(tabName)
    end)
end

--==================================================
-- ARRASTRE DE LA VENTANA
--==================================================

local dragging = false
local dragInput
local dragStart
local startPosition

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = Main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

Header.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then
        return
    end

    if input == dragInput then
        local delta = input.Position - dragStart

        Main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

