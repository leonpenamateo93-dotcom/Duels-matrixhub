local function AddToggle(title, configKey, callback)
    local row = Create("TextButton", {
        Size = UDim2.new(1, -4, 0, 43),
        BackgroundColor3 = Config.Secondary,
        Text = "",
        AutoButtonColor = false,
        Active = true,
    }, Content)

    Round(row, 8)

    Create("TextLabel", {
        Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(1, -75, 1, 0),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Config.Text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local indicator = Create("Frame", {
        Size = UDim2.fromOffset(38, 21),
        Position = UDim2.new(1, -48, 0.5, -10),
        BackgroundColor3 = Config.Panel,
        BorderSizePixel = 0,
    }, row)

    Round(indicator, 12)

    local knob = Create("Frame", {
        Size = UDim2.fromOffset(15, 15),
        Position = UDim2.new(0, 3, 0.5, -7),
        BackgroundColor3 = Config.Muted,
        BorderSizePixel = 0,
    }, indicator)

    Round(knob, 10)

    local enabled = Config[configKey] == true

    local function Refresh()
        Animate(indicator, {
            BackgroundColor3 = enabled
                and Config.Accent
                or Config.Panel
        }, 0.15)

        Animate(knob, {
            Position = enabled
                and UDim2.new(1, -18, 0.5, -7)
                or UDim2.new(0, 3, 0.5, -7),

            BackgroundColor3 = enabled
                and Config.Background
                or Config.Muted
        }, 0.15)
    end

    Refresh()

    row.Activated:Connect(function()
        enabled = not enabled
        Config[configKey] = enabled
        Config.Preferences[configKey] = enabled

        Refresh()

        if callback then
            local ok, err = pcall(callback, enabled)

            if not ok then
                warn("[Matrix Hub] " .. tostring(err))
                Notify("No se pudo aplicar el cambio.")
            end
        end
    end)

    return row
end

local function AddSlider(title, configKey, minValue, maxValue, callback)
    local row = Create("Frame", {
        Size = UDim2.new(1, -4, 0, 65),
        BackgroundColor3 = Config.Secondary,
        BorderSizePixel = 0,
    }, Content)

    Round(row, 8)

    local valueLabel = Create("TextLabel", {
        Position = UDim2.new(0, 10, 0, 5),
        Size = UDim2.new(1, -20, 0, 22),
        BackgroundTransparency = 1,
        TextColor3 = Config.Text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local track = Create("Frame", {
        Position = UDim2.new(0, 10, 0, 39),
        Size = UDim2.new(1, -20, 0, 8),
        BackgroundColor3 = Config.Panel,
        BorderSizePixel = 0,
        Active = true,
    }, row)

    Round(track, 5)

    local fill = Create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Config.Accent,
        BorderSizePixel = 0,
    }, track)

    Round(fill, 5)

    local knob = Create("Frame", {
        Size = UDim2.fromOffset(16, 16),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = Config.Text,
        BorderSizePixel = 0,
        Active = true,
    }, track)

    Round(knob, 10)

    local value = math.clamp(
        tonumber(Config[configKey]) or minValue,
        minValue,
        maxValue
    )

    local dragging = false

    local function SetValue(newValue)
        value = math.clamp(
            math.floor(newValue + 0.5),
            minValue,
            maxValue
        )

        local alpha = (value - minValue) / (maxValue - minValue)

        valueLabel.Text = title .. ": " .. tostring(value)

        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)

        Config[configKey] = value
        Config.Preferences[configKey] = value

        if callback then
            local ok, err = pcall(callback, value)

            if not ok then
                warn("[Matrix Hub] " .. tostring(err))
                Notify("Error al actualizar el valor.")
            end
        end
    end

    local function UpdateFromInput(input)
        local width = track.AbsoluteSize.X

        if width <= 0 then
            return
        end

        local alpha = math.clamp(
            (input.Position.X - track.AbsolutePosition.X) / width,
            0,
            1
        )

        SetValue(minValue + alpha * (maxValue - minValue))
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            UpdateFromInput(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            UpdateFromInput(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = false
        end
    end)

    SetValue(value)

    return row
end

local function AddButton(title, callback)
    local button = Create("TextButton", {
        Size = UDim2.new(1, -4, 0, 40),
        BackgroundColor3 = Config.Secondary,
        Text = title,
        TextColor3 = Config.Text,
        TextSize = 12,
        Font = Enum.Font.GothamSemibold,
        AutoButtonColor = false,
    }, Content)

    Round(button, 8)
    Stroke(button, Config.Accent, 0.65)

    button.Activated:Connect(function()
        Animate(button, {
            BackgroundColor3 = Config.Accent,
            TextColor3 = Config.Background,
        }, 0.1)

        task.delay(0.12, function()
            if button.Parent then
                Animate(button, {
                    BackgroundColor3 = Config.Secondary,
                    TextColor3 = Config.Text,
                }, 0.15)
            end
        end)

        if callback then
            local ok, err = pcall(callback)

            if not ok then
                warn("[Matrix Hub] " .. tostring(err))
                Notify("La operación no pudo completarse.")
            end
        end
    end)

    return button
end

