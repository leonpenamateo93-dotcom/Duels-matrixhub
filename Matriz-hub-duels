local function makeSlider(label, minimum, maximum, initial, callback)
    local holder = make("Frame", {
        Size = UDim2.new(1, -4, 0, 65),
        BackgroundColor3 = DARK,
    }, content)
    round(holder, 7)

    local valueText = make("TextLabel", {
        Size = UDim2.new(1, -16, 0, 28),
        Position = UDim2.fromOffset(8, 0),
        BackgroundTransparency = 1,
        TextColor3 = WHITE,
        TextSize = 12,
        Font = Enum.Font.Code,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, holder)

    local bar = make("TextButton", {
        Size = UDim2.new(1, -20, 0, 12),
        Position = UDim2.new(0, 10, 0, 40),
        BackgroundColor3 = Color3.fromRGB(40, 55, 45),
        Text = "",
        AutoButtonColor = false,
    }, holder)
    round(bar, 6)

    local fill = make("Frame", {
        Size = UDim2.new((initial - minimum) / (maximum - minimum), 0, 1, 0),
        BackgroundColor3 = GREEN,
        BorderSizePixel = 0,
    }, bar)
    round(fill, 6)

    local value = initial

    local function setValueFromX(x)
        local width = bar.AbsoluteSize.X
        if width <= 0 then return end

        local fraction = math.clamp(
            (x - bar.AbsolutePosition.X) / width,
            0,
            1
        )

        value = math.floor(minimum + fraction * (maximum - minimum) + 0.5)
        fill.Size = UDim2.new(fraction, 0, 1, 0)
        valueText.Text = label .. ": " .. value
        callback(value)
    end

    valueText.Text = label .. ": " .. value

    track(bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            setValueFromX(input.Position.X)
        end
    end))

    track(UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseMovement then
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                and bar:IsDescendantOf(gui) then
                setValueFromX(input.Position.X)
            end
        end
    end))

    return holder
end

-- Objetos visuales por jugador.
local function removePlayerObjects(player)
    local data = playerObjects[player]
    if data then
        if data.billboard then data.billboard:Destroy() end
        if data.tracer then data.tracer:Destroy() end
        if data.highlight then data.highlight:Destroy() end
        playerObjects[player] = nil
    end
end

local function attachCharacter(player, character)
    removePlayerObjects(player)

    if player == LocalPlayer or destroyed then return end

    local head = character:WaitForChild("Head", 5)
    if not head or destroyed or not character.Parent then return end

    local billboard = make("BillboardGui", {
        Name = "MatrixESP",
        Adornee = head,
        Size = UDim2.fromOffset(170, 48),
        StudsOffset = Vector3.new(0, 2.6, 0),
        AlwaysOnTop = true,
        Enabled = false,
    }, gui)

    local label = make("TextLabel", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "NOOB\n" .. player.DisplayName .. "\n0 studs",
        TextColor3 = COLORS[state.ColorIndex],
        TextStrokeTransparency = 0.25,
        TextSize = 13,
        Font = Enum.Font.Code,
        TextWrapped = true,
    }, billboard)

    local highlight = make("Highlight", {
        Name = "MatrixHighlight",
        Adornee = character,
        FillColor = COLORS[state.ColorIndex],
        OutlineColor = COLORS[state.ColorIndex],
        FillTransparency = 0.88,
        OutlineTransparency = 0.1,
        Enabled = false,
    }, gui)

    local tracer = make("Frame", {
        Name = "MatrixTracer",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.fromOffset(0, 2),
        BackgroundColor3 = COLORS[state.ColorIndex],
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 5,
    }, gui)

    playerObjects[player] = {
        character = character,
        billboard = billboard,
        label = label,
        highlight = highlight,
        tracer = tracer,
    }
end

local function setupPlayer(player)
    if player == LocalPlayer then return end

    if player.Character then
        task.spawn(attachCharacter, player, player.Character)
    end

    characterConnections[player] = player.CharacterAdded:Connect(function(character)
        task.spawn(attachCharacter, player, character)
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

track(Players.PlayerAdded:Connect(setupPlayer))

