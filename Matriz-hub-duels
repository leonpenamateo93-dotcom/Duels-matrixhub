    AnchorPoint = Vector2.new(0.5, 0),
    Position = UDim2.new(0.5, 0, 0.5, state.FOVRadius + 8),
    BackgroundTransparency = 1,
    Text = "TARGET: NONE",
    TextColor3 = GREEN,
    TextSize = 12,
    Font = Enum.Font.Code,
    Visible = false,
}, gui)

local function getNearestTarget()
    local camera = getCamera()
    if not camera then return nil end

    local center = camera.ViewportSize / 2
    local bestPlayer = nil
    local bestDistance = state.FOVRadius

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local head = character and character:FindFirstChild("Head")

            if humanoid and humanoid.Health > 0 and head then
                local point, visible = camera:WorldToViewportPoint(head.Position)

                if visible and point.Z > 0 then
                    local distance = (
                        Vector2.new(point.X, point.Y) - center
                    ).Magnitude

                    if distance < bestDistance then
                        bestDistance = distance
                        bestPlayer = player
                    end
                end
            end
        end
    end

    return bestPlayer
end

local function refreshVisuals()
    if destroyed then return end

    local camera = getCamera()
    if not camera then return end

    local center = camera.ViewportSize / 2
    fovCircle.Position = UDim2.fromOffset(center.X, center.Y)
    fovCircle.Size = UDim2.fromOffset(
        state.FOVRadius * 2,
        state.FOVRadius * 2
    )
    targetLabel.Position = UDim2.fromOffset(
        center.X,
        center.Y + state.FOVRadius + 8
    )

    selectedTarget = state.FOV and getNearestTarget() or nil

    targetLabel.Visible = state.FOV
    targetLabel.Text = selectedTarget
        and ("TARGET: " .. selectedTarget.DisplayName)
        or "TARGET: NONE"

    for player, data in pairs(playerObjects) do
        local character = player.Character
        local head = character and character:FindFirstChild("Head")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local valid = head and humanoid and humanoid.Health > 0

        if not valid then
            data.billboard.Enabled = false
            data.highlight.Enabled = false
            data.tracer.Visible = false
            continue
        end

        local color = COLORS[state.ColorIndex]
        local root = character:FindFirstChild("HumanoidRootPart")

        data.label.TextColor3 = color
        data.highlight.FillColor = color
        data.highlight.OutlineColor = color
        data.tracer.BackgroundColor3 = color

        data.billboard.Enabled = state.ESP
        data.highlight.Enabled = state.ESP

        if state.ESP then
            local myCharacter = LocalPlayer.Character
            local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

            local distance = myRoot
                and math.floor((myRoot.Position - head.Position).Magnitude)
                or 0

            data.label.Text = "NOOB\n" .. player.DisplayName
                .. "\n" .. distance .. " studs"
        end

        data.tracer.Visible = false

        if state.Tracers and root then
            local point, visible = camera:WorldToViewportPoint(root.Position)

            if visible and point.Z > 0 then
                local origin = Vector2.new(center.X, camera.ViewportSize.Y - 8)
                local endpoint = Vector2.new(point.X, point.Y)
                local delta = endpoint - origin

                data.tracer.Position = UDim2.fromOffset(origin.X, origin.Y)
                data.tracer.Size = UDim2.fromOffset(delta.Magnitude, 2)
                data.tracer.Rotation = math.deg(
                    math.atan2(delta.Y, delta.X)
                )
                data.tracer.Visible = true
            end
        end
    end
end

track(RunService.RenderStepped:Connect(refreshVisuals))

-- Movimiento: útil para probar tu propia experiencia privada.
local function updateHumanoid()
    local character = LocalPlayer.Character
    currentHumanoid = character and character:FindFirstChildOfClass("Humanoid")

    if currentHumanoid then
        if state.Speed then
            currentHumanoid.WalkSpeed = state.WalkSpeed
        else
            currentHumanoid.WalkSpeed = state.OriginalSpeed
        end
    end
end

local function toggleSpeed()
    state.Speed = not state.Speed
    updateHumanoid()
    notify(state.Speed and "TEST SPEED ENABLED" or "SPEED RESTORED")
end

track(LocalPlayer.CharacterAdded:Connect(function(character)
    currentHumanoid = character:WaitForChild("Humanoid", 5)
    if currentHumanoid then
        state.OriginalSpeed = currentHumanoid.WalkSpeed
        updateHumanoid()
    end
end))

if LocalPlayer.Character then
    local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        state.OriginalSpeed = humanoid.WalkSpeed
        currentHumanoid = humanoid
    end
end

-- Construcción de las pestañas.
local renderTab

local function addTab(name)
    local button = make("TextButton", {
        Size = UDim2.new(0.32, -4, 1, 0),
        BackgroundColor3 = state.SelectedTab == name and GREEN or DARK,
        Text = name,
        TextColor3 = state.SelectedTab == name and DARK or WHITE,
        TextSize = 11,
        Font = Enum.Font.Code,
        AutoButtonColor = false,
    }, tabs)
    round(button, 6)

    track(button.Activated:Connect(function()
        if destroyed then return end
        state.SelectedTab = name
        renderTab()
    end))

    return button
end

local function renderTabButtons()
    for _, child in ipairs(tabs:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    addTab("PLAYER")
    addTab("AIM")
    addTab("SETTINGS")
end

renderTab = function()
    clearContent()
    renderTabButtons()

    if state.SelectedTab == "PLAYER" then
        makeLabel(">> PLAYER ESP")

        makeButton("ESP: " .. (state.ESP and "ON" or "OFF"), function(button)
            state.ESP = not state.ESP
            button.Text = "ESP: " .. (state.ESP and "ON" or "OFF")
            notify("ESP " .. (state.ESP and "ENABLED" or "DISABLED"))
        end)

        makeButton("TRACERS: " .. (state.Tracers and "ON" or "OFF"), function(button)
            state.Tracers = not state.Tracers
            button.Text = "TRACERS: " .. (state.Tracers and "ON" or "OFF")
            notify("TRACERS " .. (state.Tracers and "ENABLED" or "DISABLED"))
        end)

        makeButton("CAMBIAR COLOR MATRIX", function()
            state.ColorIndex = state.ColorIndex % #COLORS + 1
            notify("VISUAL COLOR UPDATED")
        end)

        makeLabel("Los indicadores incluyen NOOB, nombre y distancia.")

    elseif state.SelectedTab == "AIM" then
        makeLabel(">> AIM ASSIST / TEST VISUAL")

        makeButton("FOV: " .. (state.FOV and "ON" or "OFF"), function(button)
            state.FOV = not state.FOV
            fovCircle.Visible = state.FOV
            targetLabel.Visible = state.FOV
            button.Text = "FOV: " .. (state.FOV and "ON" or "OFF")
            notify("FOV VISUAL " .. (state.FOV and "ENABLED" or "DISABLED"))
        end)

        makeSlider("FOV RADIUS", 40, 250, state.FOVRadius, function(value)
            state.FOVRadius = value
        end)

        makeLabel("Solo muestra el FOV y el objetivo visual más cercano.")
        makeLabel("No mueve la cámara ni dispara automáticamente.")

    elseif state.SelectedTab == "SETTINGS" then
        makeLabel(">> MOVEMENT / PRIVATE TEST")

        makeButton("TEST SPEED: " .. (state.Speed and "ON" or "OFF"), function(button)
            toggleSpeed()
            button.Text = "TEST SPEED: " .. (state.Speed and "ON" or "OFF")
        end)

        makeSlider("WALK SPEED", 8, 40, state.WalkSpeed, function(value)
            state.WalkSpeed = value
            if state.Speed then
                updateHumanoid()
            end
        end)

        makeButton("RESTABLECER MOVIMIENTO", function()
            state.Speed = false
            state.WalkSpeed = 24
            updateHumanoid()
            notify("MOVEMENT RESET")
            renderTab()
        end)

        makeButton("CAMBIAR COLOR", function()
            state.ColorIndex = state.ColorIndex % #COLORS + 1
            notify("COLOR UPDATED")
        end)

        makeButton("OCULTAR MENÚ", function()
            main.Visible = false
            floating.Visible = true
        end)

        makeLabel("Las preferencias duran mientras esta sesión siga activa.")
    end
end

track(floating.Activated:Connect(function()
    main.Visible = not main.Visible
    floating.Visible = not main.Visible
end))

local function cleanup()
    if destroyed then return end
    destroyed = true

    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    for player in pairs(playerObjects) do
        removePlayerObjects(player)
    end

    for player, connection in pairs(characterConnections) do
        connection:Disconnect()
        characterConnections[player] = nil
    end

    if currentHumanoid and currentHumanoid.Parent then
        currentHumanoid.WalkSpeed = state.OriginalSpeed
    end

    gui:Destroy()
end

track(close.Activated:Connect(cleanup))

renderTab()
notify("MATRIX HUB READY")
