local function button(text, callback)
    local b = make("TextButton", {
        Size = UDim2.new(1, -3, 0, 38),
        BackgroundColor3 = Color3.fromRGB(39, 47, 54),
        Text = text,
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        AutoButtonColor = true,
    }, Content)
    round(b, 7)
    b.Activated:Connect(callback)
    return b
end

local function toggle(text, key, callback)
    local b
    local function refresh()
        if b then
            b.Text = text .. (Config[key] and "  [ON]" or "  [OFF]")
            b.BackgroundColor3 = Config[key]
                and Color3.fromRGB(0, 105, 64)
                or Color3.fromRGB(39, 47, 54)
        end
    end

    b = button("", function()
        Config[key] = not Config[key]
        refresh()
        callback(Config[key])
    end)
    refresh()
end

local function slider(text, key, minValue, maxValue, callback)
    label(text .. ": " .. tostring(Config[key]))

    local bar = make("TextButton", {
        Size = UDim2.new(1, -3, 0, 30),
        BackgroundColor3 = Color3.fromRGB(42, 49, 57),
        Text = "Desliza para ajustar",
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.Gotham,
        TextSize = 10,
        AutoButtonColor = false,
    }, Content)
    round(bar, 6)

    local dragging = false

    local function update(x)
        local width = math.max(bar.AbsoluteSize.X, 1)
        local alpha = math.clamp(
            (x - bar.AbsolutePosition.X) / width, 0, 1
        )
        Config[key] = math.floor(
            minValue + alpha * (maxValue - minValue) + 0.5
        )
        bar.Text = text .. ": " .. Config[key]
        callback(Config[key])
    end

    bar.Activated:Connect(function()
        update(UserInputService:GetMouseLocation().X)
    end)

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input.Position.X)
        end
    end)

    connect(UserInputService.InputChanged, function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseMovement
        ) then
            update(input.Position.X)
        end
    end)

    connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

-- Visualización de jugadores mediante APIs normales de Roblox.

local function removeVisuals(player)
    if ESPObjects[player] then
        ESPObjects[player]:Destroy()
        ESPObjects[player] = nil
    end

    if TracerObjects[player] then
        TracerObjects[player]:Destroy()
        TracerObjects[player] = nil
    end
end

local function createESP(player, character)
    if player == LocalPlayer or not Config.ESP then return end

    local head = character:FindFirstChild("Head")
    if not head then return end

    if ESPObjects[player] then
        ESPObjects[player]:Destroy()
    end

    local billboard = make("BillboardGui", {
        Name = "MatrixESP",
        Adornee = head,
        Size = UDim2.fromOffset(180, 42),
        StudsOffset = Vector3.new(0, 2.5, 0),
        AlwaysOnTop = true,
        Enabled = true,
    }, Gui)

    local txt = make("TextLabel", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        TextColor3 = Config.ESPColor,
        TextStrokeTransparency = 0.3,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        Text = player.Name,
    }, billboard)

    ESPObjects[player] = billboard

    task.spawn(function()
        while Alive and billboard.Parent
            and character.Parent do
            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local theirRoot = character:FindFirstChild("HumanoidRootPart")

            if myRoot and theirRoot then
                local distance = (myRoot.Position - theirRoot.Position).Magnitude
                txt.Text = string.format("%s | %d studs", player.Name, distance)
                txt.TextColor3 = Config.ESPColor
            end

            task.wait(0.2)
        end
    end)
end

local function createTracer(player)
    if player == LocalPlayer or not Config.Tracers then return end

    local line = make("Frame", {
        Name = "MatrixTracer",
        AnchorPoint = Vector2.new(0, 0.5),
        Size = UDim2.fromOffset(0, 2),
        BackgroundColor3 = Config.TracerColor,
        BorderSizePixel = 0,
        Visible = false,
    }, Gui)

    TracerObjects[player] = line
end

local function attachPlayer(player)
    if player == LocalPlayer then return end

    local function characterAdded(character)
        task.wait(0.25)
        if not Alive then return end
        removeVisuals(player)

        if Config.ESP then createESP(player, character) end
        if Config.Tracers then createTracer(player) end
    end

    connect(player.CharacterAdded, characterAdded)

    if player.Character then
        characterAdded(player.Character)
    end

    connect(player.CharacterRemoving, function()
        removeVisuals(player)
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    attachPlayer(player)
end

connect(Players.PlayerAdded, attachPlayer)
connect(Players.PlayerRemoving, removeVisuals)

