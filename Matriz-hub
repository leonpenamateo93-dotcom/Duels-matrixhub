-- Arrastrar desde el encabezado.
local dragging = false
local dragStart
local initialPosition

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        initialPosition = Main.Position
    end
end)

connect(UserInputService.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

connect(UserInputService.InputChanged, function(input)
    if not dragging then return end

    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            initialPosition.X.Scale,
            initialPosition.X.Offset + delta.X,
            initialPosition.Y.Scale,
            initialPosition.Y.Offset + delta.Y
        )
    end
end)

-- FPS, ping y trazadores: un único bucle de actualización.
connect(RunService.RenderStepped, function(dt)
    if not Alive then return end

    Frames += 1
    Elapsed += dt

    if Elapsed >= 0.5 then
        FPS = math.floor(Frames / Elapsed + 0.5)
        Frames = 0
        Elapsed = 0
    end

    if os.clock() - LastStats >= 0.5 then
        LastStats = os.clock()

        local ping = 0
        local ok, result = pcall(function()
            return LocalPlayer:GetNetworkPing()
        end)

        if ok then ping = math.floor(result * 1000 + 0.5) end

        Stats.Text = string.format(
            "@%s | FPS: %d | Ping: %d ms",
            LocalPlayer.Name, FPS, ping
        )
    end

    local viewport = Camera.ViewportSize
    FOVCircle.Position = UDim2.fromOffset(
        viewport.X / 2,
        viewport.Y / 2
    )

    for player, line in pairs(TracerObjects) do
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if Config.Tracers and root and line.Parent then
            local pos, visible = Camera:WorldToViewportPoint(root.Position)

            if visible and pos.Z > 0 then
                local origin = Vector2.new(viewport.X / 2, viewport.Y - 5)
                local target = Vector2.new(pos.X, pos.Y)
                local delta = target - origin

                line.Visible = true
                line.Position = UDim2.fromOffset(origin.X, origin.Y)
                line.Size = UDim2.fromOffset(delta.Magnitude, 2)
                line.Rotation = math.deg(
                    math.atan2(delta.Y, delta.X)
                )
                line.BackgroundColor3 = Config.TracerColor
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end

    -- Selección de NPC para entrenamiento, sin apuntar a jugadores.
    if Config.AimAssist then
        local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
        local bestName = "ninguno"
        local bestDistance = Config.FOV / 2

        for _, npc in ipairs(CollectionService:GetTagged("TrainingTarget")) do
            if npc:IsA("Model") then
                local part = npc:FindFirstChild("Head")
                    or npc:FindFirstChild("HumanoidRootPart")

                if part then
                    local screenPos, visible =
                        Camera:WorldToViewportPoint(part.Position)

                    if visible and screenPos.Z > 0 then
                        local delta = (
                            Vector2.new(screenPos.X, screenPos.Y) - center
                        ).Magnitude

                        if delta < bestDistance then
                            bestDistance = delta
                            bestName = npc.Name
                        end
                    end
                end
            end
        end

        TargetLabel.Text = "Objetivo de entrenamiento: " .. bestName
    end
end)

