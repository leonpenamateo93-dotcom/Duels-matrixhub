local function renderTab(name)
    clearContent()

    if name == "Inicio" then
        label("Bienvenido, @" .. LocalPlayer.Name)
        label("FPS y ping aparecen en la cabecera.")
        label("Matrix Hub | Modo de pruebas en Studio")
        label("ESP: " .. tostring(Config.ESP))
        label("Tracers: " .. tostring(Config.Tracers))

    elseif name == "Visuales" then
        label("PLAYER ESP")
        toggle("Indicadores", "ESP", function(on)
            for _, p in ipairs(Players:GetPlayers()) do
                removeVisuals(p)
                if on and p.Character then
                    createESP(p, p.Character)
                end
                if Config.Tracers and p.Character then
                    createTracer(p)
                end
            end
        end)

        label("TRACERS")
        toggle("Líneas", "Tracers", function(on)
            for _, p in ipairs(Players:GetPlayers()) do
                if TracerObjects[p] then
                    TracerObjects[p]:Destroy()
                    TracerObjects[p] = nil
                end
                if on then createTracer(p) end
            end
        end)

        button("Color visual verde", function()
            Config.ESPColor = Color3.fromRGB(0, 255, 140)
            Config.TracerColor = Config.ESPColor
        end)

        button("Color visual azul", function()
            Config.ESPColor = Color3.fromRGB(60, 170, 255)
            Config.TracerColor = Config.ESPColor
        end)

    elseif name == "Aim Assist" then
        label("ENTRENAMIENTO CONTRA NPC")
        toggle("Activar selección de objetivo", "AimAssist", function(on)
            FOVCircle.Visible = on
            TargetLabel.Visible = on
        end)

        slider("Diámetro FOV", "FOV", 60, 300, function(value)
            FOVCircle.Size = UDim2.fromOffset(value, value)
        end)

        label("Solo selecciona NPC etiquetados TrainingTarget.")
        label("No mueve la cámara ni apunta automáticamente a jugadores.")

    elseif name == "Movement" then
        label("MOVIMIENTO DE PRUEBAS")

        slider("Velocidad", "Speed", 8, 32, function(value)
            if MovementRemote then
                MovementRemote:FireServer(value)
            end
        end)

        button("Restablecer velocidad (16)", function()
            Config.Speed = 16
            if MovementRemote then
                MovementRemote:FireServer("RESET")
            end
            renderTab("Movement")
        end)

    elseif name == "Settings" then
        label("PREFERENCIAS DE ESTA SESIÓN")

        button("Restablecer opciones visuales", function()
            Config.ESP = false
            Config.Tracers = false
            Config.AimAssist = false
            FOVCircle.Visible = false
            TargetLabel.Visible = false

            for _, p in ipairs(Players:GetPlayers()) do
                removeVisuals(p)
            end

            renderTab("Settings")
        end)

        button("Cerrar completamente Matrix Hub", function()
            Alive = false

            for _, connection in ipairs(Connections) do
                connection:Disconnect()
            end

            for _, p in ipairs(Players:GetPlayers()) do
                removeVisuals(p)
            end

            Gui:Destroy()
        end)
    end
end

