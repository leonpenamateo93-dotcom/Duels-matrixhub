local function BindHold(button, callback)
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            callback(true)
        end
    end)

    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            callback(false)
        end
    end)
end

BindHold(UpButton, function(value)
    State.Up = value
end)

BindHold(DownButton, function(value)
    State.Down = value
end)

-- 7. FUNCION PARA DETENER EL VUELO
local function StopFlying()
    State.Flying = false

    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end

    if BodyVelocity then
        BodyVelocity:Destroy()
        BodyVelocity = nil
    end

    if BodyGyro then
        BodyGyro:Destroy()
        BodyGyro = nil
    end

    State.Up = false
    State.Down = false

    FlyButton.Text = "FLY : OFF"
    FlightControls.Visible = false
end

-- 8. FUNCION PARA ACTIVAR EL VUELO
local function StartFlying()
    if not GetCharacter() then
        Status.Text = "CHARACTER NOT FOUND"
        return
    end

    State.Flying = true
    FlyButton.Text = "FLY : ON"
    FlightControls.Visible = true
    Status.Text = "FLIGHT ACTIVE"

    BodyVelocity = Instance.new("BodyVelocity")
    BodyVelocity.Name = "MatrixFlyVelocity"
    BodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    BodyVelocity.Velocity = Vector3.zero
    BodyVelocity.Parent = Root

    BodyGyro = Instance.new("BodyGyro")
    BodyGyro.Name = "MatrixFlyGyro"
    BodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    BodyGyro.P = 8000
    BodyGyro.Parent = Root

    FlyConnection = RunService.RenderStepped:Connect(function()
        if not State.Flying then return end

        if not GetCharacter() then
            StopFlying()
            return
        end

        local camera = workspace.CurrentCamera
        if not camera or not BodyVelocity or not BodyGyro then
            return
        end

        -- El joystick del celular dirige el movimiento horizontal
        local direction = Humanoid.MoveDirection

        -- Subir y bajar con botones tactiles
        if State.Up then
            direction += Vector3.yAxis
        end

        if State.Down then
            direction -= Vector3.yAxis
        end

        if direction.Magnitude > 0 then
            BodyVelocity.Velocity =
                direction.Unit * Config.FlySpeed
        else
            BodyVelocity.Velocity = Vector3.zero
        end

        BodyGyro.CFrame = camera.CFrame
    end)
end

FlyButton.Activated:Connect(function()
    if State.Flying then
        StopFlying()
        Status.Text = "FLIGHT DISABLED"
    else
        StartFlying()
    end
end)

-- 9. VELOCIDAD
local function ToggleSpeed()
    if not GetCharacter() then return end

    State.Fast = not State.Fast

    Humanoid.WalkSpeed = State.Fast
        and Config.FastSpeed
        or Config.NormalSpeed

    SpeedButton.Text = State.Fast
        and "FAST RUN : ON"
        or "FAST RUN : OFF"

    Status.Text = State.Fast
        and "SPEED BOOST ACTIVE"
        or "NORMAL SPEED"
end

SpeedButton.Activated:Connect(ToggleSpeed)

-- 10. BLOQUEO DE CAMARA
local function ToggleCameraLock()
    local camera = workspace.CurrentCamera
    if not camera then return end

    State.CameraLocked = not State.CameraLocked

    if State.CameraLocked then
        SavedCameraCFrame = camera.CFrame
        SavedCameraType = camera.CameraType
        SavedCameraSubject = camera.CameraSubject

        camera.CameraType = Enum.CameraType.Scriptable
        camera.CFrame = SavedCameraCFrame

        CameraButton.Text = "CAMERA LOCK : ON"
        Status.Text = "CAMERA LOCKED"
    else
        camera.CameraType = SavedCameraType
            or Enum.CameraType.Custom

        camera.CameraSubject = SavedCameraSubject
        CameraButton.Text = "CAMERA LOCK : OFF"
        Status.Text = "CAMERA UNLOCKED"
    end
end

CameraButton.Activated:Connect(ToggleCameraLock)

