local function setupCharacter(char)
    humanoid = char:WaitForChild("Humanoid", 10)

    if humanoid then
        humanoid.WalkSpeed = state.speedEnabled
            and state.speed or CFG.MinSpeed
    end

    state.cameraLocked = false
    cameraButton.Text = "CAMERA LOCK : OFF"
end

