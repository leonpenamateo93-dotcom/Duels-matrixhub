-- CONFIG
local CFG = {
    MinSpeed = 16,
    MaxSpeed = 40,
    DefaultSpeed = 24,
    Green = Color3.fromRGB(0, 255, 125),
    Dark = Color3.fromRGB(7, 14, 12),
    Panel = Color3.fromRGB(12, 25, 20)
}

local state = {
    speed = CFG.DefaultSpeed,
    speedEnabled = false,
    cameraLocked = false,
    highlights = false,
    training = false
}

local humanoid
local savedCamera

