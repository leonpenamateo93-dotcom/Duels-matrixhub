--==================================================
-- SPEED SLIDER
--==================================================

makeLabel(
    panel, "MOVEMENT  /  SPEED",
    UDim2.new(1, -20, 0, 22),
    UDim2.fromOffset(10, 49)
).TextXAlignment = Enum.TextXAlignment.Left

local speedValue = makeLabel(
    panel, tostring(state.speed),
    UDim2.fromOffset(45, 22),
    UDim2.new(1, -55, 0, 49)
)

local slider = Instance.new("Frame")
slider.Position = UDim2.fromOffset(12, 78)
slider.Size = UDim2.new(1, -24, 0, 12)
slider.BackgroundColor3 = Color3.fromRGB(35, 50, 42)
slider.Parent = panel
corner(slider, 6)

local fill = Instance.new("Frame")
fill.Size = UDim2.new(
    (state.speed - CFG.MinSpeed) /
    (CFG.MaxSpeed - CFG.MinSpeed), 0, 1, 0
)
fill.BackgroundColor3 = CFG.Green
fill.Parent = slider
corner(fill, 6)

local knob = Instance.new("TextButton")
knob.Size = UDim2.fromOffset(20, 24)
knob.AnchorPoint = Vector2.new(0.5, 0.5)
knob.Position = UDim2.new(fill.Size.X.Scale, 0, 0.5, 0)
knob.BackgroundColor3 = CFG.Green
knob.Text = ""
knob.Parent = slider
corner(knob, 10)

local function setSpeedFromX(x)
    local alpha = math.clamp(
        (x - slider.AbsolutePosition.X) /
        slider.AbsoluteSize.X, 0, 1
    )

    state.speed = math.floor(
        CFG.MinSpeed + alpha * (CFG.MaxSpeed - CFG.MinSpeed)
    )

    fill.Size = UDim2.new(alpha, 0, 1, 0)
    knob.Position = UDim2.new(alpha, 0, 0.5, 0)
    speedValue.Text = tostring(state.speed)

    if state.speedEnabled and humanoid then
        humanoid.WalkSpeed = state.speed
    end
end

local sliding = false

knob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliding = true
        setSpeedFromX(input.Position.X)
    end
end)

slider.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliding = true
        setSpeedFromX(input.Position.X)
    end
end)

UIS.InputChanged:Connect(function(input)
    if sliding and (
        input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement
    ) then
        setSpeedFromX(input.Position.X)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliding = false
    end
end)

local speedToggle = makeButton(
    panel, "SPEED BOOST : OFF",
    UDim2.fromOffset(10, 103),
    UDim2.new(1, -20, 0, 34)
)

speedToggle.Activated:Connect(function()
    if not humanoid then return end

    state.speedEnabled = not state.speedEnabled

    humanoid.WalkSpeed = state.speedEnabled
        and state.speed or CFG.MinSpeed

    speedToggle.Text = state.speedEnabled
        and "SPEED BOOST : ON"
        or "SPEED BOOST : OFF"
end)

--==================================================
-- CAMERA LOCK
--==================================================

local cameraButton = makeButton(
    panel, "CAMERA LOCK : OFF",
    UDim2.fromOffset(10, 145),
    UDim2.new(1, -20, 0, 34)
)

cameraButton.Activated:Connect(function()
    local camera = workspace.CurrentCamera
    if not camera then return end

    state.cameraLocked = not state.cameraLocked

    if state.cameraLocked then
        savedCamera = {
            type = camera.CameraType,
            subject = camera.CameraSubject
        }

        camera.CameraType = Enum.CameraType.Scriptable
        camera.CFrame = camera.CFrame
        cameraButton.Text = "CAMERA LOCK : ON"
    else
        camera.CameraType = savedCamera
            and savedCamera.type or Enum.CameraType.Custom

        if savedCamera then
            camera.CameraSubject = savedCamera.subject
        end

        cameraButton.Text = "CAMERA LOCK : OFF"
    end
end)

--==================================================
-- PLAYER HIGHLIGHT
-- For your own experience / authorized testing
--==================================================

local highlights = {}

local function removeHighlight(character)
    local h = highlights[character]
    if h then
        h:Destroy()
        highlights[character] = nil
    end
end

local function addHighlight(target)
    if target == player or not state.highlights then return end

    local char = target.Character
    if not char then return end

    removeHighlight(char)

    local h = Instance.new("Highlight")
    h.Name = "MatrixTargetHighlight"
    h.FillColor = CFG.Green
    h.OutlineColor = Color3.fromRGB(220, 255, 230)
    h.FillTransparency = 0.75
    h.DepthMode = Enum.HighlightDepthMode.Occluded
    h.Adornee = char
    h.Parent = char

    highlights[char] = h
end

local highlightButton = makeButton(
    panel, "PLAYER HIGHLIGHT : OFF",
    UDim2.fromOffset(10, 187),
    UDim2.new(1, -20, 0, 34)
)

highlightButton.Activated:Connect(function()
    state.highlights = not state.highlights

    highlightButton.Text = state.highlights
        and "PLAYER HIGHLIGHT : ON"
        or "PLAYER HIGHLIGHT : OFF"

    if state.highlights then
        for _, target in ipairs(Players:GetPlayers()) do
            addHighlight(target)
        end
    else
        for char in pairs(highlights) do
            removeHighlight(char)
        end
    end
end)

local function connectPlayer(target)
    target.CharacterAdded:Connect(function(char)
        if state.highlights and target ~= player then
            task.wait(0.5)
            addHighlight(target)
        end
    end)
end

for _, target in ipairs(Players:GetPlayers()) do
    connectPlayer(target)
end

Players.PlayerAdded:Connect(connectPlayer)

Players.PlayerRemoving:Connect(function(target)
    if target.Character then
        removeHighlight(target.Character)
    end
end)

