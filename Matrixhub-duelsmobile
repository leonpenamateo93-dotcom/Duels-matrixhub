local gui = Instance.new("ScreenGui")
gui.Name = "MatrixHubDuels"
gui.ResetOnSpawn = false
gui.DisplayOrder = 50
gui.Parent = playerGui

local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = obj
end

local function makeLabel(parent, text, size, pos)
    local l = Instance.new("TextLabel")
    l.Size = size
    l.Position = pos
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = CFG.Green
    l.Font = Enum.Font.Code
    l.TextSize = 14
    l.Parent = parent
    return l
end

local function makeButton(parent, text, pos, size)
    local b = Instance.new("TextButton")
    b.Size = size
    b.Position = pos
    b.BackgroundColor3 = CFG.Panel
    b.BorderColor3 = CFG.Green
    b.Text = text
    b.TextColor3 = CFG.Green
    b.TextSize = 14
    b.Font = Enum.Font.Code
    b.AutoButtonColor = true
    b.Parent = parent
    corner(b, 7)
    return b
end

